# Server Configuration
PORT=3000

# Proxy Configuration (Production)
# Trust first proxy for correct IP detection in rate limiting
# Required for deployments behind reverse proxies (Render, Cloudflare, Nginx)
# Already configured in main.ts: app.getHttpAdapter().getInstance().set('trust proxy', 1)
# No environment variable needed - handled automatically

# JWT Configuration
# CRITICAL SECURITY: Generate a strong random secret (minimum 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-production-secret-here-minimum-32-characters-required
JWT_EXPIRES_IN=7d

# Database Configuration
# For production, use PostgreSQL instead of SQLite
# DB_TYPE=postgres
# DB_HOST=your-database-host
# DB_PORT=5432
# DB_USERNAME=your-db-username
# DB_PASSWORD=your-db-password
# DB_DATABASE=skf_fitness
DB_PATH=./skf-data.sqlite

# CORS Configuration
FRONTEND_URL=https://skf-fitness.netlify.app

# Admin Configuration
# Generate a strong random secret for admin operations
ADMIN_SECRET=your-admin-secret-here

# Razorpay Payment Gateway
# Get keys from: https://dashboard.razorpay.com/app/keys
# Use TEST keys for development, LIVE keys for production
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Configuration (SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@skffitness.com

# Production Security Checklist:
# [ ] JWT_SECRET is at least 32 characters long
# [ ] JWT_SECRET is randomly generated (not a dictionary word)
# [ ] ADMIN_SECRET is strong and unique
# [ ] Razorpay keys are LIVE keys (not test)
# [ ] Database is PostgreSQL (not SQLite)
# [ ] Email is configured for password reset
# [ ] FRONTEND_URL matches your production domain
# [ ] All secrets are stored securely (not in version control)
